# Copy this file to .env and fill in your own values. Never commit .env.

# From https://developer.spotify.com/dashboard - create an app, then copy
# its Client ID/Secret and add the redirect URI below to the app's settings.
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# From https://api.setlist.fm - request a free API key (approval is near-instant).
SETLISTFM_API_KEY=your-setlistfm-api-key

# Any random string, used to sign Flask's session cookie.
FLASK_SECRET_KEY=change-me-to-something-random
